# Django Configuration
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=True

# Database Configuration (MySQL 8.0+)
DB_ENGINE=django.db.backends.mysql
DB_NAME=domovik_db
DB_USER=domovik_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=3306

# Allowed Hosts (comma-separated for production)
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Story 2.14)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@domovik.org
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=info@domovik.org

ADMIN_EMAIL=your-admin-email
SITE_URL=http://localhost:8000          # Za linkove u email-u
ORGANIZATION_NAME=Domovik               # Naziv organizacije u email-u

# Celery Configuration (Story 2.14)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
