# Git Line Ending Normalization
# Ensures consistent line endings across Windows/Linux/Mac

# Auto-detect text files and normalize to LF
* text=auto

# Python files - LF line endings
*.py text eol=lf
*.pyw text eol=lf

# Web files - LF line endings
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell scripts - LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files - CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - no line ending normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.doc binary
*.docx binary
