[Unit]
Description=Domovik Gunicorn Django Application
After=network.target mysql.service
Requires=mysql.service

[Service]
User=mihailo
Group=www-data
WorkingDirectory=/var/www/domovik
ExecStart=/var/www/domovik/venv/bin/gunicorn config.wsgi:application -c /var/www/domovik/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
